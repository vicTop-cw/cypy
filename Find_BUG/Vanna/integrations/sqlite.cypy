#!bin cypy
# ============================================================
# sqlite.cypy — SQLite SqlRunner implementation
# ============================================================

import sqlite3

from sql_runner import SqlRunner, RunSqlArgs, SqlResult
from user import RequestContext
from errors import SqlError

struct SqliteRunner:
    # SqlRunner implementation backed by SQLite
    _db_path: str
    _connection: object  # sqlite3.Connection

    def __init__(self, db_path: str):
        self._db_path = db_path
        self._connection = None

    def _get_connection(self) -> object:
        """Lazily open the database connection."""
        guard self._connection is None else return self._connection
        self._connection = sqlite3.connect(self._db_path)
        self._connection.row_factory = sqlite3.Row
        return self._connection

    def run_sql(self, args: RunSqlArgs, context: RequestContext) -> SqlResult:
        """Execute a SQL query against the SQLite database."""
        let conn: object = self._get_connection()
        let sql: str = args.sql.strip()

        try:
            let cursor = conn.execute(sql)

            let query_type: str = sql.upper().split()[0]

            if query_type == "SELECT":
                let rows_raw = cursor.fetchall()
                let columns: list<str> = [desc[0] for desc in cursor.description] if cursor.description else []
                let rows: list<dict<str, str>> = []
                for row in rows_raw:
                    let row_dict: dict<str, str> = {}
                    for col in columns:
                        row_dict[col] = str(row[col])
                    rows.append(row_dict)
                conn.commit()
                return SqlResult(columns=columns, rows=rows, query_type="SELECT")
            else:
                conn.commit()
                let affected: int = cursor.rowcount
                return SqlResult(columns=["affected"], rows=[{"affected": str(affected)}], query_type=query_type)

        except Exception as e:
            conn.rollback()
            raise SqlError(message=str(e), sql=sql, query_type=query_type)

    def close(self) -> None:
        """Close the database connection."""
        guard self._connection is not None else return
        self._connection.close()
        self._connection = None
