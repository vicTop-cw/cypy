#!bin cypy
# ============================================================
# registry.cypy — Model registry (name -> model class)
# ============================================================

# Module-level mutable state (cypyc: use struct or global pattern)
struct _RegistryState:
    _data: dict<str, object>

    def __init__(self):
        self._data = {}

    def register(self, name: str, cls: object) -> None:
        self._data[name] = cls

    def get(self, name: str) -> object:
        if name in self._data:
            return self._data[name]
        return None

let _state: _RegistryState = _RegistryState()

def register(name: str, cls: object) -> None:
    _state.register(name, cls)

def lookup(name: str) -> object:
    return _state.get(name)
