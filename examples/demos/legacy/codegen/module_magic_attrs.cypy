# 模块级魔法属性示例
# Cypy 自动生成模块级魔法属性

# 模块级变量
module_name: str = "demo_module"

# 公共 API 导出
__all__ = ["public_func", "PublicClass"]

# 私有变量（不会被导入）
_private_value: int = 42

class PublicClass:
    def greet(self) -> str:
        return "Hello from PublicClass"

def public_func() -> str:
    return "This is a public function"

def _private_func() -> str:
    return "This is a private function"

def main() -> int:
    # 访问自动生成的魔法属性
    print(f"Module name: {__name__}")
    print(f"Module file: {__file__}")
    print(f"Compile time: {__compile_time__}")
    print(f"Target platform: {__target__}")
    print(f"Build profile: {__profile__}")
    
    # 访问用户定义的属性
    print(f"Public API: {__all__}")
    print(f"Private deps: {__private__}")
    
    return 0