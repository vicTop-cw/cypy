# 构建块语法示例
# =: 变量构建块 - 自动将最后表达式作为返回值
# ~: 调用构建块 - 返回构建参数对象
# *: 生成器构建块 - 返回迭代器，yield 产生参数包

def main() -> int:
    # 变量构建块 =:
    result =:
        x = 10
        y = 20
        x + y  # 最后表达式作为返回值，result = 30
    
    print(f"Variable build block result: {result}")
    
    # 调用构建块 ~:
    def create_user(name: str, age: int) -> str:
        return f"User: {name}, Age: {age}"
    
    user = create_user ~:
        name = "Alice"
        age = 30
    
    print(f"Call build block result: {user}")
    
    # 生成器构建块 *:
    def process_items(items):
        for item in items:
            print(f"Processing: {item}")
        return len(items)
    
    count = process_items *:
        yield (1, "first")
        yield (2, "second")
        yield (3, "third")
    
    print(f"Generator build block processed: {count} items")
    
    return 0