# 嵌套语法边界示例
# 演示深层嵌套的语法结构：嵌套泛型、嵌套函数、嵌套 match、嵌套循环

# ============================================================
# 1. 嵌套泛型类型
# ============================================================

type Matrix3D = list<list<list<int>>>
type NestedDict = dict<str, dict<str, list<int>>>
type DeepTuple = tuple<tuple<tuple<int, int>, int>, int>

let cube: Matrix3D = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]
let nested: NestedDict = {"outer": {"inner": [10, 20, 30]}}
let deep: DeepTuple = (((1, 2), 3), 4)

# 嵌套泛型函数
def flatten_3d(matrix: list<list<list<int>>>) -> list<int>:
    let result: list<int> = []
    for plane in matrix:
        for row in plane:
            for elem in row:
                result.append(elem)
    return result


# ============================================================
# 2. 嵌套函数定义
# ============================================================

def outer_func(x: int) -> int:
    def middle_func(y: int) -> int:
        def inner_func(z: int) -> int:
            return z * 3
        return inner_func(y) * 2
    return middle_func(x) + 1


# ============================================================
# 3. 嵌套 match 表达式
# ============================================================

def classify_nested(value: int | str | list<int>) -> str:
    match value:
        case int(n):
            match n:
                case x if x < 0:
                    return "negative int"
                case 0:
                    return "zero"
                case x if x < 100:
                    return "small positive"
                case _:
                    return "large positive"
        case str(s):
            match len(s):
                case 0:
                    return "empty string"
                case 1:
                    return "single char"
                case _:
                    return f"string len={len(s)}"
        case list(items):
            match len(items):
                case 0:
                    return "empty list"
                case 1:
                    return f"single element: {items[0]}"
                case _:
                    return f"list of {len(items)} items"
        case _:
            return "unknown"


# ============================================================
# 4. 嵌套循环与条件
# ============================================================

def nested_loops_with_conditions(n: int) -> list<tuple<int, int>>:
    let result: list<tuple<int, int>> = []
    for i in range(n):
        for j in range(n):
            if i < j:
                if (i + j) % 2 == 0:
                    if i * j > 4:
                        result.append((i, j))
    return result


# ============================================================
# 5. 嵌套结构体
# ============================================================

struct Address:
    street: str
    city: str
    zip: str

struct Person:
    name: str
    age: int
    address: Address

struct Company:
    name: str
    ceo: Person
    hq: Address

def get_company_city(company: Company) -> str:
    return company.hq.city

def get_ceo_zip(company: Company) -> str:
    return company.ceo.address.zip


# ============================================================
# 6. 嵌套 guard 语句
# ============================================================

def nested_guard_check(x: int, y: int) -> str:
    guard x > 0 else return "x must be positive"
    guard y > 0 else return "y must be positive"
    guard x + y < 100 else return "sum too large"
    guard x * y < 1000 else return "product too large"
    return "valid"


# ============================================================
# 7. 嵌套 defer 语句
# ============================================================

def nested_defer_demo() -> list<str>:
    let order: list<str> = []
    defer:
        order.append("outer defer")
    def inner():
        defer:
            order.append("inner defer")
        order.append("inner body")
    order.append("before inner")
    inner()
    order.append("after inner")
    return order


# ============================================================
# 主入口
# ============================================================

if __name__ == "__main__":
    print("=== Nested Syntax Demo ===")

    print("--- nested generics ---")
    print(f"cube: {cube}")
    print(f"flatten: {flatten_3d(cube)}")
    print(f"nested dict: {nested}")

    print("--- nested functions ---")
    print(f"outer_func(5): {outer_func(5)}")

    print("--- nested match ---")
    print(f"classify(-5): {classify_nested(-5)}")
    print(f"classify(0): {classify_nested(0)}")
    print(f"classify(50): {classify_nested(50)}")
    print(f"classify('hi'): {classify_nested('hi')}")
    print(f"classify([1,2,3]): {classify_nested([1, 2, 3])}")

    print("--- nested loops ---")
    print(f"nested_loops(5): {nested_loops_with_conditions(5)}")

    print("--- nested structs ---")
    let addr: Address = Address(street="123 Main St", city="Springfield", zip="62701")
    let person: Person = Person(name="Alice", age=30, address=addr)
    let company: Company = Company(name="AcmeCorp", ceo=person, hq=addr)
    print(f"company city: {get_company_city(company)}")
    print(f"ceo zip: {get_ceo_zip(company)}")

    print("--- nested guards ---")
    print(f"check(5, 10): {nested_guard_check(5, 10)}")
    print(f"check(-1, 10): {nested_guard_check(-1, 10)}")
    print(f"check(50, 60): {nested_guard_check(50, 60)}")

    print("--- nested defer ---")
    print(f"defer order: {nested_defer_demo()}")


suite NestedSyntaxTests:
    test flatten_3d:
        let result = flatten_3d([[[1, 2], [3, 4]], [[5, 6], [7, 8]]])
        assert len(result) == 8
        assert result[0] == 1
        assert result[-1] == 8

    test nested_functions:
        assert outer_func(5) == 31

    test classify_negative:
        assert classify_nested(-5) == "negative int"

    test classify_zero:
        assert classify_nested(0) == "zero"

    test classify_empty_string:
        assert classify_nested("") == "empty string"

    test classify_empty_list:
        assert classify_nested([]) == "empty list"

    test nested_loops:
        let result = nested_loops_with_conditions(5)
        assert len(result) > 0

    test nested_guard_valid:
        assert nested_guard_check(5, 10) == "valid"

    test nested_guard_x_negative:
        assert nested_guard_check(-1, 10) == "x must be positive"
